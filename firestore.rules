rules_version = '2';

// Reglas de la base de datos (Firestore):
// - Solo usuarios con sesión iniciada leen los historiales.
// - Cada usuario crea registros a su nombre y solo puede eliminar los suyos ("Volver a pendientes").
// - Nadie modifica registros existentes.
service cloud.firestore {
  match /databases/{database}/documents {
    function conSesion() {
      return request.auth != null;
    }

    function historial() {
      return conSesion()
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoPorCorreo == request.auth.token.email;
    }

    match /memos/{id} {
      allow read: if conSesion();
      allow create: if historial();
      allow delete: if conSesion() && resource.data.creadoPor == request.auth.uid;
      allow update: if false;
    }

    match /devoluciones/{id} {
      allow read: if conSesion();
      allow create: if historial();
      allow delete: if conSesion() && resource.data.creadoPor == request.auth.uid;
      allow update: if false;
    }

    // Estado de la contraseña de cada usuario (temporal o definitiva): solo el propio usuario.
    match /usuarios/{uid} {
      allow read, write: if conSesion() && request.auth.uid == uid;
    }
  }
}
